# Copy to .env with: sudo ./scripts/setup.sh
# setup.sh fills the generated secrets. Set the domain values yourself.

# Public names. Leave these as example.com until DNS exists;
# setup will use an internal certificate instead of Let's Encrypt.
DOMAIN=example.com
ACME_EMAIL=admin@example.com
DASHBOARD_HOST=dashboard.example.com
AUTH_HOST=auth.example.com
MEDIA_HOST=media.example.com
GIT_HOST=git.example.com
FILES_HOST=files.example.com
OFFICE_HOST=office.example.com
APPS_HOST=apps.example.com
NOTIFY_HOST=notify.example.com
GRAFANA_HOST=grafana.example.com

# Cloudflare API token with Zone.DNS edit on this domain.
# Empty until you are ready for public certificates.
CLOUDFLARE_API_TOKEN=

# Generated by setup.sh. Do not commit real values.
AUTHENTIK_SECRET_KEY=
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_TAG=2026.8.3
PG_PASS=
DASHBOARD_OIDC_SECRET=
EXECUTOR_TOKEN=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_OIDC_SECRET=
FORGEJO_OIDC_SECRET=
NEXTCLOUD_OIDC_SECRET=
JELLYFIN_OIDC_SECRET=
FORGEJO_DB_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_ADMIN_PASSWORD=
NTFY_ADMIN_PASSWORD=
LAVALINK_PASSWORD=
COOLIFY_DB_PASSWORD=
COOLIFY_REDIS_PASSWORD=
COOLIFY_APP_KEY=
COOLIFY_APP_ID=
COOLIFY_ROOT_PASSWORD=
COOLIFY_PUSHER_APP_ID=
COOLIFY_PUSHER_APP_KEY=
COOLIFY_PUSHER_APP_SECRET=
# Created in the Coolify UI after the first login. The Websites page reads it.
# Leave empty until that token exists. Coolify still starts without it.
COOLIFY_API_TOKEN=

# Chat history kept this many days.
CHAT_RETENTION_DAYS=90

# Set a real Hugging Face model id before: sudo ./scripts/up.sh ai
# Example: Qwen/Qwen2.5-3B-Instruct
VLLM_MODEL=
# Optional smaller model that stays up beside the chat model.
# Example: Qwen/Qwen2.5-1.5B-Instruct
# When this is set, scripts/up.sh ai also starts the ai-manager profile
# and gives the chat model 65% of GPU memory so both can fit.
VLLM_MANAGER_MODEL=
HF_TOKEN=

# Accept the Minecraft EULA yourself, then set TRUE before enabling the games profile.
MINECRAFT_EULA=FALSE
MINECRAFT_MEMORY=4G
MINECRAFT_RCON_PASSWORD=

# Discord status bot. Leave empty to keep that container off.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# Optional LanCache listener. Must NOT be the address Caddy uses.
# Example: 192.168.50.11
LANCACHE_BIND_IP=
LANCACHE_DISK_SIZE=200g
LANCACHE_MAX_AGE=30d

# Off-server backup destination. Empty means backup.sh refuses to pretend
# a same-disk copy is a real backup.
BACKUP_TARGET=
